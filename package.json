{
  "name": "learn-english-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node -e \"require('fs').mkdirSync('.next/standalone/.next/static/css', { recursive: true })\" && cross-env OPEN_NEXT_DEBUG=true opennextjs-cloudflare build --skipBuild && node -e \"const fs = require('fs'); if (fs.existsSync('.open-next/worker.js')) { fs.renameSync('.open-next/worker.js', '.open-next/_worker.js'); }\" && node patch_worker.js",
    "build:cf": "npm run build",
    "deploy": "npm run build:cf && robocopy .open-next\\assets .open-next /E /NFL /NDL /NJH /NJS || node -e \"process.exit(0)\" && npx wrangler pages deploy .open-next --project-name ieltswisdom",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.96.0",
    "bytez.js": "^3.0.0",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "framer-motion": "^12.34.1",
    "lenis": "^1.3.21",
    "lucide-react": "^0.574.0",
    "mathjs": "^15.1.1",
    "next": "15.1.12",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "openai": "^6.25.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
